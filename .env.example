NODE_ENV=development
PORT=8090
OPENROUTER_API_KEY=your_openrouter_api_key_here
RESEND_API_KEY=your_resend_api_key_here

# OpenRouter models (ids)
AI_MODEL=deepseek/deepseek-v4-flash
RUNTIME_AI_MODEL=deepseek/deepseek-v4-flash
INTENTION_AI_MODEL=deepseek/deepseek-v4-flash
ICON_AI_MODEL=deepseek/deepseek-v4-flash
# Edit picker (client; not env): deepseek/deepseek-v4-flash, xiaomi/mimo-v2.5,
# google/gemini-2.5-flash-lite, google/gemini-3-flash-preview, openai/gpt-5.4-mini,
# google/gemini-3.1-pro-preview, anthropic/claude-sonnet-5, openai/gpt-5.5,
# anthropic/claude-opus-4.8, anthropic/claude-fable-5

# User AI credits (OpenRouter cost × markup billed against wallet, USD)
CREDIT_MARKUP=5
CREDIT_FREE_GRANT_USD=0.99
CREDIT_PREMIUM_GRANT_USD=5.99
CREDIT_FLOOR_RUNTIME_USD=0.001
CREDIT_FLOOR_EDIT_USD=0.01

# App runtime host (numeric subdomains) + platform origin for redirects/links.
# Local (same shape as prod): http://34211.localhost:8090/
APP_RUNTIME_HOST=localhost
PLATFORM_ORIGIN=http://localhost:8090

# Production:
# NODE_ENV=production
# PORT=8090
# APP_RUNTIME_HOST=remiix.app
# PLATFORM_ORIGIN=https://remiix.app
# Legacy hosts abblet.com / *.abblet.app permanently redirect to remiix.app / *.remiix.app
