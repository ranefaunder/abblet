NODE_ENV=development
PORT=8090
OPENROUTER_API_KEY=your_openrouter_api_key_here
RESEND_API_KEY=your_resend_api_key_here
AI_MODEL=anthropic/claude-haiku-4.5
# Cheap model for Abblet.ai() in app runtimes (not the edit chat model)
RUNTIME_AI_MODEL=google/gemini-2.5-flash-lite

# User AI credits (OpenRouter cost × markup billed against wallet, USD)
CREDIT_MARKUP=2
CREDIT_FREE_GRANT_USD=0.99
CREDIT_PREMIUM_GRANT_USD=5.99
CREDIT_FLOOR_RUNTIME_USD=0.001
CREDIT_FLOOR_EDIT_USD=0.01

# App runtime host (numeric subdomains) + platform origin for redirects/links.
# Local (same shape as prod): http://34211.localhost:8090/
APP_RUNTIME_HOST=localhost
PLATFORM_ORIGIN=http://localhost:8090

# Production:
# NODE_ENV=production
# PORT=8090
# APP_RUNTIME_HOST=remiix.app
# PLATFORM_ORIGIN=https://remiix.app
# Legacy hosts abblet.com / *.abblet.app permanently redirect to remiix.app / *.remiix.app
