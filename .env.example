NODE_ENV=development
PORT=8090
OPENROUTER_API_KEY=your_openrouter_api_key_here
RESEND_API_KEY=your_resend_api_key_here
AI_MODEL=anthropic/claude-haiku-4.5

# App runtime host (numeric subdomains) + platform origin for redirects/links.
# Local (same shape as prod): http://34211.app.localhost:8090/
APP_RUNTIME_HOST=app.localhost
PLATFORM_ORIGIN=http://localhost:8090

# Production on abblet.com (see ops/deploy.sh):
# NODE_ENV=production
# PORT=8090
# APP_RUNTIME_HOST=abblet.app
# PLATFORM_ORIGIN=https://abblet.com
