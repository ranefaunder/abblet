NODE_ENV=development
PORT=8090
OPENROUTER_API_KEY=your_openrouter_api_key_here
RESEND_API_KEY=your_resend_api_key_here

AI_MODEL=google/gemini-3-flash-preview
RUNTIME_AI_MODEL=google/gemini-3-flash-preview
INTENTION_AI_MODEL=google/gemini-3-flash-preview
ICON_AI_MODEL=google/gemini-3-flash-preview

CREDIT_MARKUP=5
CREDIT_FREE_GRANT_USD=0.99
CREDIT_PREMIUM_GRANT_USD=5.99
CREDIT_FLOOR_RUNTIME_USD=0.001
CREDIT_FLOOR_EDIT_USD=0.01

APP_RUNTIME_HOST=localhost
PLATFORM_ORIGIN=http://localhost:8090

# Set to 1 only behind a reverse proxy that overwrites X-Forwarded-For.
# Prefer CF-Connecting-IP (Cloudflare) when available — used automatically.
# TRUSTED_PROXY=1
